---
import { site, nav } from "../data/site";
---

<header class="sidebar">
    <div>
        <div class="photo">
            <img src={site.photo} alt={`Photo of ${site.name}`} width="112" height="112" />
        </div>

        <p class="status mono"><span class="dot"></span>{site.status}</p>
        <h1>{site.name}</h1>
        <h2>{site.role}</h2>
        <p class="bio">{site.bio}</p>

        <nav aria-label="Sections">
            <ul>
                {
                    nav.map((item, i) => (
                        <li>
                            <a href={item.href} data-nav>
                                <span class="idx mono">0{i + 1}</span>
                                <span class="line" />
                                <span class="label">{item.label}</span>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>
    </div>

    <div class="bottom">
        <div class="socials">
            {
                site.socials.map((s) => (
                    <a href={s.url} target="_blank" rel="noopener" class="mono">
                        {s.label} ↗
                    </a>
                ))
            }
            {site.email && <a href={`mailto:${site.email}`} class="mono">Email ↗</a>}
        </div>
        {site.resume && <a href={site.resume} class="btn" download>↓ Download resume</a>}
    </div>
</header>

<style>
    .sidebar {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 40px;
        padding-block: 64px;
    }

    .photo {
        position: relative;
        width: 112px;
        height: 112px;
        margin-bottom: 24px;
    }
    .photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 22px;
        border: 1px solid var(--border);
    }
    /* offset violet frame behind the photo */
    .photo::before {
        content: "";
        position: absolute;
        inset: 0;
        transform: translate(8px, 8px);
        border: 1.5px solid var(--accent);
        border-radius: 22px;
        z-index: -1;
        transition: transform 0.3s;
    }
    .photo:hover::before {
        transform: translate(4px, 4px);
    }

    .status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.75rem;
        color: #86efac;
        margin-bottom: 12px;
    }
    .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.6);
        animation: pulse 2s infinite;
    }
    @keyframes pulse {
        to {
            box-shadow: 0 0 0 10px rgba(34, 197, 94, 0);
        }
    }

    h1 {
        font-size: clamp(2.2rem, 4vw, 3rem);
        line-height: 1.1;
        letter-spacing: -0.02em;
        color: var(--text-strong);
    }
    h2 {
        font-size: 1.15rem;
        font-weight: 600;
        color: var(--accent-soft);
        margin-top: 8px;
    }
    .bio {
        max-width: 34ch;
        margin-top: 16px;
        color: var(--text);
    }

    nav ul {
        list-style: none;
        padding: 0;
        margin-top: 48px;
    }
    nav a {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 0;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--muted);
    }
    .idx {
        font-size: 0.7rem;
        color: var(--accent-soft);
    }
    .line {
        width: 32px;
        height: 1px;
        background: currentColor;
        transition: width 0.25s;
    }
    nav a:hover,
    nav a.active {
        color: var(--text-strong);
    }
    nav a:hover .line,
    nav a.active .line {
        width: 64px;
    }

    .socials {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        margin-bottom: 20px;
        font-size: 0.85rem;
    }
    .socials a {
        color: var(--muted);
        transition: color 0.2s;
    }
    .socials a:hover {
        color: var(--accent-soft);
    }

    @media (min-width: 1024px) {
        .sidebar {
            position: sticky;
            top: 0;
            height: 100vh;
            padding-block: 88px;
        }
    }
    @media (max-width: 1023px) {
        nav {
            display: none;
        }
    }
</style>

<script>
    // Highlight the nav link of the section currently on screen
    const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav]");
    const observer = new IntersectionObserver(
        (entries) => {
            for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                links.forEach((a) =>
                    a.classList.toggle("active", a.hash === `#${entry.target.id}`),
                );
            }
        },
        { rootMargin: "-40% 0px -55% 0px" },
    );
    links.forEach((a) => {
        const section = document.querySelector(a.hash);
        if (section) observer.observe(section);
    });
</script>
