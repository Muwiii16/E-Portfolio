---
// Shows a project image, or a generated "code window" placeholder when there is none.
interface Props {
    src?: string;
    title: string;
}
const { src, title } = Astro.props;
---

{
    src ? (
        <img src={src} alt={`${title} screenshot`} loading="lazy" class="img" />
    ) : (
        <div class="placeholder" aria-hidden="true">
            <div class="bar">
                <i />
                <i />
                <i />
            </div>
            <span class="mono">{title}</span>
        </div>
    )
}

<style>
    .img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s;
    }
    .placeholder {
        width: 100%;
        height: 100%;
        display: grid;
        grid-template-rows: auto 1fr;
        background:
            radial-gradient(circle at 80% 120%, rgba(124, 58, 237, 0.45), transparent 60%),
            var(--surface);
    }
    .bar {
        display: flex;
        gap: 5px;
        padding: 8px 10px;
        border-bottom: 1px solid var(--border);
    }
    .bar i {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--border);
    }
    .placeholder span {
        place-self: center;
        padding: 12px;
        text-align: center;
        font-size: 0.85rem;
        color: var(--accent-soft);
    }
</style>
